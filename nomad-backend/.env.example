# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Stripe Configuration (Test Mode Keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase Admin SDK Configuration
# Note: In production, it's safer to provide the path to your service account JSON file
FIREBASE_PROJECT_ID=nomad-yellowstone
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nomad-yellowstone.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Configuration (Nodemailer via Gmail app passwords)
EMAIL_USER=hq@nomadyellowstone.com
EMAIL_PASS=your-gmail-app-password

# Admin Authentication
ADMIN_API_KEY=super-secret-admin-key-2026

# Quo (OpenPhone) API Integration
# API Key from OpenPhone (use the raw key, without "Bearer" prefix)
QUO_API_KEY=your_openphone_api_key_here
# The registered OpenPhone phone number in E.164 format (e.g. +15555555555)
QUO_FROM_NUMBER=+15555555555
# The phone number where the owner notifications will be sent (e.g. +15555555555)
OWNER_PHONE=+15555555555
# Optional OpenPhone User ID to associate with the sent messages
QUO_USER_ID=your_openphone_user_id_here

